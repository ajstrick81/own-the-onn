{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Power states vs. network activity",
    "output": "power-states.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "screen-off",
        "label": "Screen off isn't offline",
        "focus": [
          "awake",
          "dozing"
        ],
        "note": "After the inactivity timeout the screen goes dark, but traffic went up, not down."
      },
      {
        "id": "open-questions",
        "label": "Still being measured",
        "focus": [
          "boot",
          "standby",
          "wake"
        ],
        "note": "Boot check-ins and power-button standby are pending reruns."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Screen on"
    },
    {
      "id": "dark",
      "label": "Screen dark"
    },
