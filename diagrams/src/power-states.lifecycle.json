      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "measured"
    },
    {
      "id": "dozing",
      "type": "waiting",
      "label": "Screen off",
      "sublabel": "~173 conn/h",
      "lane": "dark",
      "col": 0,
      "tag": "measured"
    },
    {
      "id": "standby",
      "type": "neutral",
      "label": "Standby",
      "sublabel": "power button",
      "lane": "dark",
      "col": 2,
      "step": "04",
