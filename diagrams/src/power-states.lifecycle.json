      "step": "01",
      "tag": "pending"
    },
    {
      "id": "awake",
      "type": "active",
      "label": "Awake, idle",
      "sublabel": "~72 conn/h",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "measured"
    },
    {
      "id": "playing",
      "type": "active",
      "label": "Playing",
      "sublabel": "~673 conn/h (Prime)",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "measured"
    },
    {
      "id": "wake",
      "type": "active",
      "label": "Wake",
